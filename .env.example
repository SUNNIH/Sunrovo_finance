# ---------------------------------------------------------------------------
# PLATINUM TRUST BANK (PLT) - environment variables
# Copy to .env.local and fill in real values. NEVER commit the filled file.
# Anything without NEXT_PUBLIC_ stays server-side only.
# ---------------------------------------------------------------------------

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_ENV="demo"
NODE_ENV="development"

# Database (PostgreSQL + Prisma)
DATABASE_URL="postgresql://plt_user:plt_password@localhost:5432/plt_dev?schema=public"

# Sessions / auth (Phase 2)
SESSION_SECRET="replace-with-a-64-char-random-hex-string"
SESSION_COOKIE_NAME="plt_session"

# Email (verification, password reset) (Phase 2)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="PLATINUM TRUST BANK <no-reply@platinumtrust.example>"

# Bybit public market data (spot only, no user credentials required)
BYBIT_MODE="public"
BYBIT_REST_BASE_URL="https://api.bybit.com"
# NEXT_PUBLIC_ because the browser connects to this directly for live
# ticker updates (see lib/bybit/websocket.ts) — it's Bybit's public
# stream, not a secret, so client exposure is intentional.
NEXT_PUBLIC_BYBIT_WS_URL="wss://stream.bybit.com/v5/public/spot"

# Bybit optional demo-trading phase (server-side only, never NEXT_PUBLIC_).
# Leave blank until Phase 2 of the Bybit integration is explicitly approved.
BYBIT_API_KEY=""
BYBIT_API_SECRET=""
BYBIT_RECV_WINDOW="5000"

# Encryption key for at-rest encryption of stored integration credentials
CREDENTIALS_ENCRYPTION_KEY="replace-with-a-32-byte-random-key"

# Rate limiting
RATE_LIMIT_REDIS_URL=""
